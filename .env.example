# ── Frontend Configuration (Vercel) ─────────────────────────────────────────

# The URL of your deployed Render backend (e.g., https://spade-arts-backend.onrender.com)
# Leave this blank or commented out for local development to use the Vite proxy.
VITE_BACKEND_URL=

# ── Firebase Frontend Configuration ─────────────────────────────────────────
# Add your Firebase project configuration here if it's not already hard-coded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
