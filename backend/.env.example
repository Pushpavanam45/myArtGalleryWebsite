# ── Brevo (Sendinblue) transactional email ──────────────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# The email address you verified in Brevo as a sender
BREVO_SENDER_EMAIL=

# The display name shown as the sender
BREVO_SENDER_NAME=Spade Arts

# The email address where contact form submissions will be delivered
BREVO_RECEIVER_EMAIL=

# Optional – override the port the Express server listens on (default: 5000)
# PORT=5000

# ── Firebase Admin SDK Service Account (required for full admin-role check) ──
#
# HOW TO GET THIS VALUE:
#
#  1. Go to Firebase Console → Project Settings → Service Accounts
#     https://console.firebase.google.com/project/artgallery-69371/settings/serviceaccounts/adminsdk
#
#  2. Click "Generate new private key" and download the JSON file.
#
#  3. Open the JSON file and copy its ENTIRE contents.
#
#  4. Paste it as a SINGLE LINE below, enclosed in single quotes:
#     FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"artgallery-69371",...}'
#
#  IMPORTANT:
#  - The value must be valid JSON on a single line.
#  - Do NOT commit the real key to Git.
#  - Do NOT put the real key in this .env.example file.
#  - If the private_key field contains literal \n characters, leave them as-is;
#    the backend will handle them automatically.
#
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Cloudinary Image Storage (for production deployment) ──────────────────────
# Create a free account at https://cloudinary.com/
# Get these credentials from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend URL for CORS (Required for production) ─────────────────────────
# The domain where your frontend is hosted (e.g. https://spade-arts.vercel.app)
# This prevents unauthorized domains from accessing your backend
FRONTEND_URL=
